---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="No Receipt Found - Arky Foundation" description="There is no signed receipt for this address.">
  <main id="main" class="nf-page">
    <section class="nf-hero" aria-labelledby="nf-title">
      <p class="kicker reveal hero-load">HTTP 404&ensp;·&ensp;no receipt found</p>
      <h1 id="nf-title" class="nf-h1 reveal hero-load" style="--reveal-delay: 60ms">Unverifiable.</h1>
      <p class="nf-lead reveal hero-load" style="--reveal-delay: 120ms">
        There is no signed receipt for this address &mdash; nothing here can be replayed.
        In this house, that means it didn&rsquo;t happen.
      </p>
      <dl class="nf-record reveal hero-load" style="--reveal-delay: 180ms" aria-label="Verification result">
        <div><dt>status</dt><dd class="nf-fail">NOT_FOUND</dd></div>
        <div><dt>cid</dt><dd>&mdash; (no canonical body to address)</dd></div>
        <div><dt>sig</dt><dd>&mdash; (nothing was signed)</dd></div>
      </dl>
      <div class="nf-actions reveal hero-load" style="--reveal-delay: 240ms">
        <Button tone="primary" href="/">Back to a verifiable page</Button>
        <Button href="/verify">Verify a real receipt</Button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .nf-hero {
    width: min(100% - calc(var(--gutter) * 2), var(--max-text));
    margin: 0 auto;
    min-height: calc(100svh - var(--header-h) - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-12) 0;
  }

  .nf-h1 {
    margin: var(--space-6) 0 var(--space-6);
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 620;
    letter-spacing: -0.028em;
    line-height: 1;
  }

  .nf-lead {
    max-width: 46ch;
    margin: 0 0 var(--space-8);
    color: var(--text-dim);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
  }

  .nf-record {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 460px;
    margin: 0 0 var(--space-8);
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--oxide);
    border-radius: 5px;
    background: rgba(251, 250, 245, 0.7);
    padding: var(--space-5) var(--space-6);
  }

  .nf-record > div {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .nf-record dt {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nf-record dd {
    margin: 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .nf-record .nf-fail {
    color: var(--oxide);
    letter-spacing: 0.06em;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
